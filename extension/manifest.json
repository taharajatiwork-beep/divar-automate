{
  "manifest_version": 3,
  "name": "دیوار — دستیار انتشار آگهی",
  "description": "پیش‌پرکردن خودکار فیلدهای فرم ثبت آگهی دیوار (فقط متن — بدون ارسال خودکار)",
  "version": "0.1.0",
  "permissions": ["activeTab", "storage", "tabs", "debugger"],
  "host_permissions": ["http://localhost:3000/*", "https://divar.ir/*"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://divar.ir/*", "https://*.divar.ir/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
